{
    "version": 2,
    "builds": [
        {
            "src": "apps/frontend/package.json",
            "use": "@vercel/next",
            "config": {
                "distDir": "dist"
            }
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "apps/frontend/$1"
        }
    ],
    "buildCommand": "cd apps/frontend && node pre-build.js && npm run build",
    "outputDirectory": "apps/frontend/dist",
    "installCommand": "npm install"
}